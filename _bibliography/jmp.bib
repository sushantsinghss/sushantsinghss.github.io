@ARTICLE{singh2025structural,
	author = {{Singh}, Sushant},
	title = {Structural Adjustments and Food Sovereignty},
	year = {2026},
    abstract = {In this paper I study the effects of IMF program participation and associated policy conditions, known as ‘conditionalities,’ on food self-sufficiency of IMF members for the period of 1980-2019. In the empirical analysis, I employ a compound instrumental variable approach within a system of three equations, estimated using maximum likelihood. After accounting for confounding economic and climatic factors and addressing selection bias, I find no robust evidence that IMF program participation has any effect on food self-sufficiency. In contrast, program conditions have a significant effect on food self sufficiency. Based on point estimates, I find that each additional binding IMF condition reduces the food self-sufficiency ratio by 0.0128 percentage points. This is driven by structural policy reforms. Disaggregating conditions by policy area, the findings suggest that IMF conditionality pertaining to fiscal policies may enhance food self-sufficiency. However, IMF conditionality pertaining to Institutional reforms, State owned enterprise privatization reform and pricing hinders food self-sufficiency.},
	year={2025},
pdf = {https://www.dropbox.com/scl/fi/1qsmlvz4ak1u3qyyu6pc0/IMF.pdf?rlkey=vac6fm1hd9h9cqfre72uoh7xo&st=4uatbcvp&e=1&dl=0},
    my_type = {job market paper}
}


