@ARTICLE{singh2026trade,
	author = {Singh, Sushant},
	title = {Revisiting Trade-embodied Emissions and Pollution Haven Hypothesis: Accounting for Global Value Chain},
	year = {2026},
abstract = {This paper investigates the empirical link between environmental policy and trade flows by incorporating global value chain in the analysis. To do so, I use CO2 embodied in domestic final demand as an indicator of the pollution content of imports (PCI), which is corrected for trade in value-added flows. I begin with investigation of North-South patterns, in particular if the PCI is relatively larger in Northern countries. Then, I carry out analysis of the determinants of PCI using a gravity-based empirical framework to quantitatively measure the impact of Pollution Haven (PH) and Factor endowment(FE) effects. Using several proxies for policy stringency, I show that PCI is higher for the North countries, which have more stringent regulations.  PH effect is found to be larger than what previous studies find, while FE has the opposite effect on PCI of the North. The former dominates the latter, together confirming the pollution haven hypothesis.},
my_type = {working papers}
}

@ARTICLE{singh2026sanctions,
	author = {Singh, Sushant},
	title = {How Sanctions Shape the Carbon Footprint of Global Trade?},
	year = {2026},
abstract= {conomic sanctions are among the most frequently used instruments of foreign policy, yet their environmental consequences are largely unmeasured. This paper estimates how sanctions affect the greenhouse gas emissions embodied in bilateral trade, combining sector-level carbon footprints from the Eora MRIO for 189 countries and 26 sectors over 1990--2017 with the GSDB-R5 and leveraging the latest developments in the structural gravity literature. Trade sanctions reduce the emissions embodied in trade between the sanctioning and the sanctioned country by about 8\% on average. Complete sanctions reduce them by about 24% and partial sanctions by about 8%, and partial export sanctions are especially effective (about 18%). The effects are broad-based across sectors, including the most carbon-intensive ones. I also propose a direct test of whether sanctioned importers shift their sourcing toward more carbon-intensive third-country suppliers, which bears on whether sanctions belong in the accounting of carbon leakage.},
my_type = {working papers}
}
